# Copia este archivo como .env.local para desarrollo, y carga los mismos
# valores en Vercel (Settings → Environment Variables) para producción.
# Nunca subas .env.local al repositorio: es público.

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el servidor (crons y admin). Se salta las reglas de la base:
# nunca exponerla en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ───────────────────────────────────────────────────────────────
# URL pública del sitio (sitemap, robots, Open Graph y JSON-LD). Debe ser
# un dominio que YA resuelva: si apunta a uno que no existe, el sitemap
# publica URLs que Google no puede rastrear y los links compartidos en redes
# salen con la vista previa rota. Si se deja vacía, en Vercel se detecta
# sola el dominio de producción y en local cae a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Admin (/admin) ──────────────────────────────────────────────────────
# Una clave por persona: nombre:clave separados por coma.
#   ADMIN_USERS=cristopher:una-clave-larga,socia:otra-clave-larga
# La clave puede llevar ':' pero NO ','. El nombre queda registrado en lo
# que hace cada persona. Sin ADMIN_USERS (ni el par antiguo de abajo), el
# admin responde error 500 y no deja entrar a nadie.
ADMIN_USERS=
# Par antiguo de una sola clave compartida. Solo se usa si ADMIN_USERS está
# vacía; bórralo de Vercel cuando ADMIN_USERS ya funcione.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Mercado Libre ───────────────────────────────────────────────────────
# App del DevCenter de ML: el servidor pide con ella un token para leer
# precios, vendedores y fichas.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Parámetros de la cuenta de afiliado (matt_word y matt_tool de los links).
# Si están definidos, el admin no permite cambiarlos ni guardar links de
# otra cuenta: protege la comisión si alguien pega un link ajeno.
AFFILIATE_WORD=comparatech
AFFILIATE_TOOL=
# Comisión mínima estimada (en pesos) para que la prospección proponga un
# producto. Bajo este piso no vale la pena publicarlo.
MIN_COMMISSION_CLP=700

# ── Crons ───────────────────────────────────────────────────────────────
# Secreto de los crons (Vercel, GitHub Actions y pg_cron de Supabase). Debe
# medir 16 caracteres o más, idealmente 32: con uno más corto los crons
# responden 401 a todos. Es el mismo valor en Vercel, en el secreto
# CRON_SECRET de GitHub y en el Vault de Supabase ('cron_secret').
# Para generar uno:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
# Avisos de healthcheck (por ejemplo healthchecks.io): cada cron llama a su
# URL al terminar, o a URL/fail si falló. Si el aviso no llega, el servicio
# manda un correo. Opcionales.
HEALTHCHECK_REFRESH_URL=
HEALTHCHECK_PROSPECT_URL=
# Lo mismo para el respaldo semanal (/api/cron/backup, los lunes).
HEALTHCHECK_BACKUP_URL=
# /api/health responde 503 si el último precio revisado tiene más de estos
# minutos (o la prospección más de 26 horas). Opcional, por defecto 90.
HEALTH_MAX_PRICE_AGE_MIN=

# ── Correo diario (Resend) ──────────────────────────────────────────────
# El cron de prospección lo envía al terminar, con lo que entró ese día y lo
# que quedó pendiente de revisar. La API key se saca de resend.com/api-keys.
RESEND_API_KEY=
# Destinatarios; acepta varios separados por coma.
DIGEST_TO=comparatech.cl@gmail.com
# Remitente. Mientras el dominio propio no esté verificado en Resend, dejar
# vacío para usar su dominio de prueba (onboarding@resend.dev), que solo
# puede escribirle a la casilla dueña de la cuenta.
DIGEST_FROM=

# ── Telegram (opcional) ─────────────────────────────────────────────────
# Bot que publica ofertas en el canal. Sin token o sin canal no se publica
# nada y el resto funciona igual.
TELEGRAM_BOT_TOKEN=
# Canal donde publica el bot, por ejemplo @comparatech_ofertas.
TELEGRAM_CHANNEL_ID=
# Link público al canal, para el botón "Recibe ofertas en Telegram" del sitio.
NEXT_PUBLIC_TELEGRAM_URL=
