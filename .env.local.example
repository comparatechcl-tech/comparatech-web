# Supabase — crear proyecto nuevo en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el backend (api/catalog-sync), nunca exponer en el cliente
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en sitemap, robots, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://comparatech.cl

# Endpoint /api/catalog-sync (consumido por Make.com)
# Déjalo en false hasta revisar el endpoint y activarlo a propósito.
ENABLE_CATALOG_SYNC=false
CATALOG_SYNC_TOKEN=

# App de Mercado Libre (DevCenter) — usada solo para el canje OAuth único en
# /api/ml-oauth-callback. El resultado (access/refresh token) se copia a mano
# a Make, no se guarda acá.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://comparatech-web.vercel.app/api/ml-oauth-callback

# Endpoint /api/catalog-prospect (consumido por Make.com) — guarda candidatos
# en product_candidates, nunca en products. Déjalo en false hasta activar el
# escenario de Make a propósito.
ENABLE_CATALOG_PROSPECT=false
CATALOG_PROSPECT_TOKEN=
